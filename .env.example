EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat PUBLIC iOS API key (starts with appl_). When set, the paywall
# shows the real App Store subscription prices and can charge. Leave empty to
# keep the free-Lifetime-only paywall. Requires a new native build to take effect.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# ── Google AdMob (free users only; see ADS_SETUP.md) ─────────────────────────
# Build-time values read by app.config.js. For EAS builds set them as EAS
# environment variables (production). Development builds always use Google's
# test ads; preview builds do too via ADS_USE_TEST_IDS=1 in eas.json.
# Without the App IDs, Google's sample (test-only) App IDs are used.
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=
REWARDED_UNIT_IOS=
REWARDED_UNIT_ANDROID=
# Interstitials are OFF by default (ENABLE_INTERSTITIALS / ads_enable_interstitials).
INTERSTITIAL_UNIT_IOS=
INTERSTITIAL_UNIT_ANDROID=
